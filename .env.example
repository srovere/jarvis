# Sólo para ejecución local fuera de Docker (copiar a .env, git-ignorado).
# En Docker Compose la contraseña de la base viene del secreto pg_password
# (PGPASSWORD_FILE=/run/secrets/pg_password) y no se usa este archivo.
MCP_BEARER_TOKEN=change-me
DATABASE_URL=postgres://jarvis:jarvis@127.0.0.1:5432/jarvis
# Alternativas a DATABASE_URL:
#   DATABASE_URL_FILE=/ruta/a/archivo-con-la-url
#   PGPASSWORD_FILE=/ruta/a/pg_password   (+ JARVIS_DB_HOST/USER/NAME; por defecto db/jarvis/jarvis)
JARVIS_CONFIG=./jarvis.config.yaml
# Flujo OAuth loopback (comando `auth`).
# JARVIS_OAUTH_PORT=53682
# JARVIS_OAUTH_BIND=127.0.0.1
