# Only for running locally outside Docker (copy to .env, git-ignored).
# In Docker Compose the database password comes from the pg_password secret
# (PGPASSWORD_FILE=/run/secrets/pg_password) and this file is not used.
MCP_BEARER_TOKEN=change-me
DATABASE_URL=postgres://jarvis:jarvis@127.0.0.1:5432/jarvis
# Alternatives to DATABASE_URL:
#   DATABASE_URL_FILE=/path/to/file-with-the-url
#   PGPASSWORD_FILE=/path/to/pg_password   (+ JARVIS_DB_HOST/USER/NAME; defaults db/jarvis/jarvis)
JARVIS_CONFIG=./jarvis.config.yaml
# OAuth loopback flow (`auth` command).
# JARVIS_OAUTH_PORT=53682
# JARVIS_OAUTH_BIND=127.0.0.1
