# Only for running the apps locally outside Docker (copy to .env, git-ignored).
# With Docker (./jarvis start) none of this is used: the database password comes from the pg_password secret
# (PGPASSWORD_FILE=/run/secrets/pg_password) and everything else is configured in the browser.
DATABASE_URL=postgres://jarvis:jarvis@127.0.0.1:5432/jarvis
# Alternatives to DATABASE_URL:
#   DATABASE_URL_FILE=/path/to/file-with-the-url
#   PGPASSWORD_FILE=/path/to/pg_password   (+ JARVIS_DB_HOST/USER/NAME; defaults db/jarvis/jarvis)

# Data directory with tokens/, google/oauth-client.json and agent/claude-token (default /data).
# JARVIS_DATA_DIR=./data
# Optional YAML configuration (see jarvis.config.example.yaml); absent = defaults.
# JARVIS_CONFIG=./jarvis.config.yaml

# api only: built dashboard, MCP server URL and its bearer token file.
# JARVIS_WEB_DIST=./apps/web/dist
# JARVIS_MCP_URL=http://127.0.0.1:3002/mcp
# JARVIS_MCP_TOKEN_FILE=./secrets/mcp_token

# OAuth loopback flow of the `auth` CLI command.
# JARVIS_OAUTH_PORT=53682
# JARVIS_OAUTH_BIND=127.0.0.1
