#!/bin/sh
# Jarvis launcher: ./jarvis start | stop | status | logs [docker compose logs args]
# Creates the secrets on first run (never overwrites), starts the stack and waits for the dashboard.
set -eu
umask 077

ROOT=$(cd "$(dirname "$0")" && pwd)
URL="http://127.0.0.1:3000"
TIMEOUT="${JARVIS_START_TIMEOUT:-120}"

usage() {
  cat >&2 <<'USAGE'
Usage: ./jarvis <command>

  start        create the secrets if missing, build and start Jarvis, wait until it is ready
  stop         stop Jarvis (data is kept)
  status       show the state of the containers
  logs [args]  follow all logs; with arguments they go to `docker compose logs` (e.g. ./jarvis logs -f api)
USAGE
}

warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Prints N random bytes as hex: openssl if present, /dev/urandom otherwise.
random_hex() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$1"
  else
    od -An -N "$1" -tx1 /dev/urandom | tr -d ' \n'
    echo
  fi
}

# Creates secrets/<name> (mode 0600) with <bytes> random bytes unless it already exists.
ensure_secret() {
  [ -s "$ROOT/secrets/$1" ] && return 0
  random_hex "$2" > "$ROOT/secrets/$1"
  chmod 600 "$ROOT/secrets/$1"
  echo "Created secrets/$1"
}

need_compose() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed or not in PATH. Install Docker Engine or Docker Desktop."
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required ('docker compose version' failed). See https://docs.docker.com/compose/install/"
}

wait_for_api() {
  waited=0
  while [ "$waited" -lt "$TIMEOUT" ]; do
    id=$(docker compose ps -q api 2>/dev/null || true)
    if [ -n "$id" ]; then
      health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null || true)
      [ "$health" = "healthy" ] && return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

start() {
  need_compose
  mkdir -p "$ROOT/secrets"
  ensure_secret mcp_token 32
  ensure_secret pg_password 24

  if [ "$(id -u)" != "1000" ]; then
    warn "your user is uid $(id -u), but the containers run as uid 1000 and must read secrets/."
    warn "Grant only that uid read access, e.g.: sudo setfacl -m u:1000:x secrets && sudo setfacl -m u:1000:r secrets/mcp_token secrets/pg_password"
    warn "(or: sudo chown 1000:1000 secrets/*). See 'Permission denied reading secrets' in the README. Never chmod 644."
  fi

  if docker volume ls --format '{{.Name}}' 2>/dev/null | grep -q 'jarvis_tokens$'; then
    warn "found an old 'jarvis_tokens' volume from phase 1. Jarvis now keeps its data in 'jarvis_data' and does not migrate it;"
    warn "connect your accounts again in the browser, then remove the old volume with: docker volume rm <project>_jarvis_tokens"
  fi

  cd "$ROOT"
  docker compose up -d --build

  echo "Waiting for Jarvis to be ready (up to ${TIMEOUT}s)..."
  if ! wait_for_api; then
    die "the api did not become healthy within ${TIMEOUT}s. Run './jarvis logs api' to see why."
  fi
  echo "Open $URL"
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  start) start ;;
  stop) need_compose; cd "$ROOT"; docker compose down ;;
  status) need_compose; cd "$ROOT"; docker compose ps ;;
  logs) need_compose; cd "$ROOT"; [ "$#" -eq 0 ] && set -- -f; docker compose logs "$@" ;;
  *) usage; exit 2 ;;
esac
